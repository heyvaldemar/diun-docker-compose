# Diun — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in the compose file's `x-images` block, so `git pull` delivers
# the version combination this repository has tested. To pin a different
# version yourself, uncomment and set:
# DIUN_IMAGE_TAG=ghcr.io/crazy-max/diun:4.33.0@sha256:…
#
# There is no Traefik here and no certificate: Diun has no web interface. It
# watches, and it tells you. That is the whole surface.

# ──────────────────────────────────────────────────────────────────────────────
# Where to send what it finds. REQUIRED.
# ──────────────────────────────────────────────────────────────────────────────
#
# The `slack` notifier speaks the Slack incoming-webhook format, which
# Mattermost, Rocket.Chat and Discord all accept — so one variable covers most
# of what people actually use:
#
#   Slack        an incoming webhook URL from a Slack app
#   Mattermost   Integrations -> Incoming Webhooks; paste the URL as-is
#   Rocket.Chat  Administration -> Integrations -> Incoming; same
#   Discord      the webhook URL with /slack appended
#
# Diun supports email, Telegram, Gotify, ntfy, Matrix, Pushover, Signal and
# more; every one is an environment variable of the form DIUN_NOTIF_<NAME>_*
# and can be added to the compose file's environment block. See
# https://crazymax.dev/diun/notif/ — the compose file is the place to add them,
# not this one, because they are configuration rather than secrets.
DIUN_WEBHOOK_URL=https://chat.example.com/hooks/replace-me

# ──────────────────────────────────────────────────────────────────────────────
# What it watches, and when
# ──────────────────────────────────────────────────────────────────────────────

# A cron expression. Daily rather than hourly on purpose: a new image is not an
# emergency, and a notifier that interrupts you is one you turn off.
# DIUN_WATCH_SCHEDULE=0 8 * * *

# Watch every running container, rather than only those labelled
# diun.enable=true. Upstream defaults to the opposite, and the opposite means a
# new stack is unwatched until somebody remembers to label it. Nobody
# remembers. Exclude a noisy container with `diun.enable=false` on it.
# DIUN_WATCH_BY_DEFAULT=true

# Notify about images seen for the very first time. Off, because with
# watch-by-default the first scan discovers everything you run at once and this
# would empty all of it into your chat in one go. Diun still records them; only
# real changes notify afterwards.
#
# Turn it on temporarily if you want to confirm the notification path works
# without waiting for an upstream release — and turn it off again.
# DIUN_WATCH_FIRSTCHECKNOTIF=false

# Diun's own log level: panic, fatal, error, warn, info, debug, trace.
# DIUN_LOG_LEVEL=info

# Whether to include Diun's own structured field block in each message. Off:
# the message already carries everything a human needs to decide.
# DIUN_NOTIF_RENDERFIELDS=false

# Timezone for the schedule and for timestamps.
# DIUN_TZ=Etc/UTC

# ──────────────────────────────────────────────────────────────────────────────
# Backups (defaults shown; override only to tune)
# ──────────────────────────────────────────────────────────────────────────────
#
# The archive covers /data, which holds one small database: the images Diun has
# already seen and the digests they resolved to. Losing it is not a disaster —
# the next scan rebuilds it — but if first-check notification is on, rebuilding
# means one message per image you run, all at once.

# BACKUP_INIT_SLEEP=30m
# BACKUP_INTERVAL=24h
# DATA_BACKUP_PRUNE_DAYS=7
# DATA_BACKUPS_PATH=/srv/diun-data/backups
# DATA_PATH=/data
# DATA_BACKUP_NAME=diun-data-backup

# Resource limits (defaults shown). What moves these is the number of images to
# check, and only while a scan is running.
# DIUN_MEMORY_LIMIT=256m
# DIUN_CPU_LIMIT=1.0
# DIUN_MEMORY_RESERVATION=32m
# DIUN_CPU_RESERVATION=0.1
# DIUN_DOCKERPROXY_MEMORY_LIMIT=64m
# DIUN_DOCKERPROXY_CPU_LIMIT=0.5
# DIUN_DOCKERPROXY_MEMORY_RESERVATION=16m
# DIUN_DOCKERPROXY_CPU_RESERVATION=0.1
# DIUN_BACKUPS_MEMORY_LIMIT=256m
# DIUN_BACKUPS_CPU_LIMIT=0.5
# DIUN_BACKUPS_MEMORY_RESERVATION=16m
# DIUN_BACKUPS_CPU_RESERVATION=0.1

# How long docker waits before SIGKILL.
# DIUN_STOP_GRACE_PERIOD=60s

# Image versions. Every image is pinned by digest inside the compose file
# (x-images block); set the matching variable here to run a different version
# of that one image while every other pin stays as tested. Needs Docker
# Compose v2.5 or newer (2022).
# DIUN_IMAGE_VERSION=4.33.0
# DIUN_DOCKERPROXY_IMAGE_VERSION=v0.5.0
# DIUN_BACKUPS_IMAGE_VERSION=3.22
